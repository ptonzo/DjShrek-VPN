APP_NAME=DjShrek VPN
APP_ENV=development
APP_SECRET=replace-with-at-least-32-random-characters
DJSHREK_ADMIN_API_KEY=replace-with-another-long-random-secret
PUBLIC_BASE_URL=http://localhost:8000
DATABASE_PATH=/app/data/djshrek.db
HEALTHCHECK_TIMEOUT_SECONDS=3
# JSON array. Keep real VLESS URIs and server hostnames in private deployment secrets, never in Git.
NODE_CONFIG_JSON=[]
